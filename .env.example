NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://radar_runtime:change_me@localhost:5432/radar_comercial
# Solo para ejecutar npm run db:migrate. No usar esta credencial en el servidor API.
MIGRATION_DATABASE_URL=postgresql://radar_migration_owner:change_me@localhost:5432/radar_comercial
DB_SSL=false
LOG_LEVEL=info
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_WINDOW_MS=60000
METRICS_ENABLED=false
SUPABASE_URL=
# Public client key only (publishable key preferred; legacy anon key also supported).
SUPABASE_PUBLISHABLE_KEY=
# Maximum age of an access token accepted by the API (300-86400 seconds).
SUPABASE_JWT_MAX_AGE_SECONDS=3600
